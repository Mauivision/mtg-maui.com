# MTG Maui League — copy to .env.local (local) or set in Vercel (production). Never commit real URLs/passwords.
#
# Supabase: Dashboard → Project Settings → Database → Connection string → URI (Direct or Transaction per Supabase + Prisma docs).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Leave empty when using a real DATABASE_URL. Set to true only for demo mode without a database.
USE_STATIC_LEAGUE_DATA=
SKIP_ADMIN_AUTH=true
NEXT_PUBLIC_WIZARDS_LOGIN=
ADMIN_SIMPLE_USERNAME=Admin
ADMIN_SIMPLE_PASSWORD=12345
ADMIN_SIMPLE_SECRET=mtg-maui-admin-secret
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=generate-a-secure-secret
